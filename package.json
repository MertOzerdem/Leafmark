{
  "name": "leafmark",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "web:export": "expo export -p web && node scripts/generate-precache-manifest.mjs",
    "web:serve": "node scripts/serve-dist.mjs",
    "typecheck": "tsc --noEmit",
    "check:expo-dependencies": "expo install --check",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@noble/hashes": "^1.8.0",
    "expo": "~58.0.19",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-image-colors": "^2.6.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/src/**/*.test.ts?(x)"
    ]
  }
}
