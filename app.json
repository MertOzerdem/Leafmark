{
  "expo": {
    "name": "Leafmark",
    "slug": "leafmark",
    "scheme": "leafmark",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "web"],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.leafmark.reader",
      "supportsTablet": true,
      "isTabletOnly": true
    },
    "plugins": [
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "Allow Leafmark to add illustrations to your private Book pages." }]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/leafmark-icon.png"
    },
    "experiments": {
      "baseUrl": "/Leafmark"
    }
  }
}
